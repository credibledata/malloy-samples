|##
##|(markdown) text_1
# Tom Hanks explored
|##

import {movies} from "./imdb.malloy"

source: movies_tiles is movies extend {
  # dashboard
  view: tile_1 is {
    where: name2 = 'Tom Hanks' and startYear < 2010
    nest: works_with is by_name + {nest: job_list limit: 10 }
    nest: title_list
    nest: genre_and_time
    nest: titles_dashboard
  }
}
