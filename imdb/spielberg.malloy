##| artifact { layout=linear title="Steven Spielberg"
  tiles=[
    text_1 { kind=text },
    text_2 { kind=text },
    "movies_tiles -> tile_1",
    text_3 { kind=text },
    "movies_tiles -> tile_2"
  ]
}
|##
##|(markdown) text_1
# Steven Spielberg
What did he direct? When? Who does he commonly work with and on what?
|##

import {movies} from "./imdb.malloy" 

##|(markdown) text_2
## People that work with Steven Spielberg 
|##

##|(markdown) text_3
## Steven Spielberg dashboard
|##

source: movies_tiles is movies extend {
  view: tile_1 is {
    limit: 20
    where: name2 = 'Steven Spielberg'
      and name != name2
    group_by: name
    aggregate: title_count
    aggregate: `years` is concat(replace(min(startYear)::string, '.0', ''), '-', replace(max(startYear)::string, '.0', ''))
    order_by: title_count desc
  
    nest: job_list
    nest: title_list 
  }

  # dashboard
  view: tile_2 is titles_dashboard + { 
    where: name2 = 'Steven Spielberg'
  }
}
