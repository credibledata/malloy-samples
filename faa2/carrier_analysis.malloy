|##
##|(markdown) text_1
# Carrier Analysis
|##

import {flights, carriers} from './flights.malloy'

##|(markdown) text_2
### Basic Statistics
|##

##|(markdown) text_3
### Flights Over Time by Carrier
|##

##|(markdown) text_4
### Carrier Overview
A dashboard showing high-level information for each Carrier"
|##

source: flights_tiles is flights extend {
  view: tile_1 is top_carriers

  view: tile_2 is carriers_over_time

  # dashboard
  view: tile_3 is {
    group_by: carrier_name is carriers.nickname
    aggregate:
      flight_count
      # percent
      percent_of_this_carriers_flights_to_all_destinations
        is flight_count/all(flight_count)
    nest: top_destinations + {
      aggregate:
        flights_to_dest_all_carriers is exclude(flight_count, carrier_name)
      limit: 5
    }
    nest: top_routes_map
  }
}
