##|(markdown) text_1
# eCommerce
This dataset represents transactional database for a fictitious eCommerce business. 
|##

import {order_items} from "./ecommerce.malloy"

##|(markdown) text_2
## Business Overview
A high level overview of performance of the business
|##

##|(markdown) text_3
## Customer Lookup
Look up information about a customer and view their history.
|##

##|(markdown) text_4
# Brand Dashboard
An overview of brand performance
|##

##|(markdown) text_5
## Frequent Returners
Lists individuals who return a lot of merchandise
|##

source: order_items_tiles is order_items extend {
  view: tile_1 is business_overview_dashboard

  # dashboard
  view: tile_2 is customer_dashboard + {where: users.full_name = 'Mary Smith'}

  view: tile_3 is brand_dashboard

  view: tile_4 is frequent_returners
}
